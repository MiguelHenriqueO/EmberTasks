generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  idusuario      Int              @id @default(autoincrement())
  nome           String           @db.VarChar(80)
  email          String           @unique @db.VarChar(80)
  senha          String           @db.VarChar(255)
  comentario     Comentario[]
  projeto        Projeto[]
  tarefa         Tarefa[]
  tarefaadm      tarefaadm[]
  usuarioprojeto usuarioprojeto[]

  @@map("usuario")
}

model Projeto {
  idprojeto      Int              @id @default(autoincrement())
  nome           String           @db.VarChar(80)
  descricao      String           @db.VarChar(250)
  status         String           @db.VarChar(80)
  datacriacao    DateTime         @db.Date
  datamax        DateTime         @db.Date
  criadorid      Int
  usuario        Usuario          @relation(fields: [criadorid], references: [idusuario], onDelete: NoAction, onUpdate: NoAction)
  tarefa         Tarefa[]
  usuarioprojeto usuarioprojeto[]

  @@map("projeto")
}

model Tarefa {
  idtarefa     Int          @id @default(autoincrement())
  descricao    String       @db.VarChar(250)
  status       String       @db.VarChar(50)
  area_atuacao String       @db.VarChar(80)
  tipo         String       @db.VarChar(50)
  datacriacao  DateTime     @db.Date
  datamax      DateTime     @db.Date
  idprojeto    Int?
  idcriador    Int?
  comentario   Comentario[]
  usuario      Usuario?     @relation(fields: [idcriador], references: [idusuario], onDelete: NoAction, onUpdate: NoAction)
  projeto      Projeto?     @relation(fields: [idprojeto], references: [idprojeto], onDelete: NoAction, onUpdate: NoAction)
  tarefaadm    tarefaadm[]

  @@map("tarefa")
}

model Comentario {
  idcomentario Int      @id @default(autoincrement())
  conteudo     String   @db.VarChar(250)
  datacriacao  DateTime @db.Date
  fixado       Boolean  @default(false)
  idusuario    Int
  idtarefa     Int
  tarefa       Tarefa   @relation(fields: [idtarefa], references: [idtarefa], onDelete: NoAction, onUpdate: NoAction)
  usuario      Usuario  @relation(fields: [idusuario], references: [idusuario], onDelete: NoAction, onUpdate: NoAction)

  @@map("comentario")
}

model tarefaadm {
  idadm     Int     @id @default(autoincrement())
  idusuario Int
  idtarefa  Int
  tarefa    Tarefa  @relation(fields: [idtarefa], references: [idtarefa], onDelete: NoAction, onUpdate: NoAction)
  usuario   Usuario @relation(fields: [idusuario], references: [idusuario], onDelete: NoAction, onUpdate: NoAction)

  @@unique([idusuario, idtarefa])
}

model usuarioprojeto {
  iduserproj    Int     @id @default(autoincrement())
  idusuario     Int
  idprojeto     Int
  cargo         String  @db.VarChar(80)
  administrador Boolean @default(false)
  projeto       Projeto @relation(fields: [idprojeto], references: [idprojeto], onDelete: NoAction, onUpdate: NoAction)
  usuario       Usuario @relation(fields: [idusuario], references: [idusuario], onDelete: NoAction, onUpdate: NoAction)

  @@unique([idusuario, idprojeto])
}

